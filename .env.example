# Copy this file to .env and fill in the values you need.
# None of these are required to run the app — it works fully offline using
# LLM_PROVIDER=local (extractive answers, no external API calls).

ENV=dev
DEBUG=true

# ---- LLM provider: "openai" | "ollama" | "local" ----
LLM_PROVIDER=local
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_TIMEOUT_SECONDS=90

# ---- Retrieval tuning ----
TOP_K=4
CONFIDENCE_THRESHOLD=0.45

# ---- Server ----
API_HOST=0.0.0.0
API_PORT=8000
STREAMLIT_PORT=8501
